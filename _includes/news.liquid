<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    {% assign news_animate = false %}
    {% if include.animate or include.limit %}
      {% assign news_animate = true %}
    {% endif %}

    {% if news_animate and news_limit > 1 %}
      <div class="news-slider-container">
        <div class="news-slider animate">
          {% for copy in (1..2) %}
            <div
              class="news-list"
              {% if copy == 2 %}
                aria-hidden="true"
              {% endif %}
            >
              {% for item in news limit: news_limit %}
                <article class="news-row">
                  <time class="news-date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
                  <div class="news-copy">
                    {% if item.inline %}
                      {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                    {% else %}
                      <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="news-list">
        {% for item in news limit: news_limit %}
          <article class="news-row">
            <time class="news-date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
            <div class="news-copy">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
