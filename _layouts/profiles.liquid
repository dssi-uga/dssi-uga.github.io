---
layout: page
---

<style>
  .people-shell {
    --dssi-line: rgba(23, 23, 23, 0.12);
    --dssi-muted: #5c6670;
    --dssi-soft: color-mix(in srgb, var(--global-card-bg-color) 90%, var(--global-theme-color) 10%);
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: none;
    overflow-x: hidden;
  }

  html[data-theme="dark"] .people-shell {
    --dssi-line: rgba(255, 255, 255, 0.14);
    --dssi-muted: #c5ccd3;
  }

  .people-inner {
    width: min(1120px, calc(100vw - 3rem));
    margin: 0 auto;
  }

  .section-kicker {
    margin-bottom: 0.5rem;
    color: var(--global-theme-color);
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .principal-card {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2.6rem;
    padding: 1rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
  }

  .principal-image {
    height: 260px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--dssi-soft);
  }

  .principal-image figure,
  .principal-image picture,
  .principal-image img {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .principal-image img {
    object-fit: cover;
  }

  .principal-name {
    margin: 0 0 0.25rem;
    color: var(--global-text-color);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.12;
  }

  .principal-role,
  .member-role,
  .member-unit,
  .alumni-meta {
    color: var(--dssi-muted);
    line-height: 1.45;
  }

  .principal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin: 0.75rem 0 1rem;
    font-size: 0.92rem;
  }

  .principal-details p {
    margin-bottom: 0.65rem;
    line-height: 1.58;
  }

  .member-group {
    padding: 2.5rem 0;
    border-top: 1px solid var(--dssi-line);
  }

  .group-head {
    margin-bottom: 1rem;
  }

  .group-head h2 {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 800;
  }

  .group-description {
    max-width: 760px;
    margin: 0.35rem 0 0;
    color: var(--dssi-muted);
    line-height: 1.55;
  }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .member-card {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 0.9rem;
    min-height: 150px;
    padding: 0.85rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .member-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--global-theme-color) 50%, var(--dssi-line));
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
  }

  .member-photo,
  .member-placeholder,
  .alumni-photo,
  .alumni-placeholder {
    overflow: hidden;
    border-radius: 8px;
    background: var(--dssi-soft);
  }

  .member-photo,
  .member-placeholder {
    width: 96px;
    height: 116px;
  }

  .member-photo figure,
  .member-photo picture,
  .member-photo img,
  .alumni-photo figure,
  .alumni-photo picture,
  .alumni-photo img {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .member-photo img,
  .alumni-photo img {
    object-fit: cover;
  }

  .member-placeholder,
  .alumni-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--global-theme-color);
    font-weight: 800;
  }

  .member-placeholder {
    font-size: 1.4rem;
  }

  .member-name {
    margin-bottom: 0.12rem;
    color: var(--global-text-color);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .member-role,
  .member-unit {
    font-size: 0.88rem;
  }

  .member-focus,
  .member-project {
    margin: 0.5rem 0 0;
    color: var(--global-text-color);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .member-project strong {
    color: var(--global-theme-color);
  }

  .member-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: baseline;
    margin-top: 0.6rem;
    font-size: 0.84rem;
  }

  .member-links-label {
    color: var(--dssi-muted);
    font-weight: 800;
  }

  .member-links a {
    font-weight: 800;
  }

  .member-links a + a::before {
    content: ",";
    margin-right: 0.35rem;
    color: var(--dssi-muted);
    font-weight: 400;
  }

  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .alumni-card {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.85rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
  }

  .alumni-photo,
  .alumni-placeholder {
    width: 74px;
    height: 82px;
  }

  .alumni-placeholder {
    font-size: 1.1rem;
  }

  .alumni-name {
    color: var(--global-text-color);
    font-weight: 800;
    line-height: 1.25;
  }

  .alumni-project {
    margin-top: 0.35rem;
    color: var(--global-text-color);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .member-grid,
    .alumni-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .people-inner {
      width: min(100% - 2rem, 1120px);
    }

    .principal-card,
    .member-card,
    .alumni-card {
      grid-template-columns: 1fr;
    }

    .principal-image,
    .member-photo,
    .member-placeholder,
    .alumni-photo,
    .alumni-placeholder {
      width: 100%;
    }

    .member-photo,
    .member-placeholder {
      height: 220px;
    }
  }
</style>

<div class="people-shell">
  <div class="people-inner">
    {% if page.principal %}
      <section class="principal-card scroll-reveal">
        {% if page.principal.image %}
          <div class="principal-image">
            {% assign principal_image_path = page.principal.image | prepend: "assets/img/" %}
            {% include figure.liquid loading="eager" path=principal_image_path alt=page.principal.name %}
          </div>
        {% endif %}
        <div>
          <div class="section-kicker">Principal Investigator</div>
          <h2 class="principal-name">{{ page.principal.name }}</h2>
          <div class="principal-role">{{ page.principal.role }}</div>
          <div class="principal-meta">
            {% if page.principal.email %}
              <a href="mailto:{{ page.principal.email }}">{{ page.principal.email }}</a>
            {% endif %}
            {% if page.principal.office %}
              <span>{{ page.principal.office }}</span>
            {% endif %}
            {% if page.principal.scholar %}
              <a href="{{ page.principal.scholar }}">Google Scholar</a>
            {% endif %}
          </div>
          {% if page.principal.content %}
            {% capture principal_content %}{% include_relative {{ page.principal.content }} %}{% endcapture %}
            {% assign principal_parts = principal_content | split: "---" %}
            {% if principal_parts.size > 2 %}
              {% assign principal_content = principal_parts[2] %}
            {% endif %}
            <div class="principal-details">{{ principal_content | markdownify }}</div>
          {% endif %}
        </div>
      </section>
    {% endif %}

    {% for group in page.member_groups %}
      <section class="member-group scroll-reveal">
        <div class="group-head">
          <div class="section-kicker">Current Members</div>
          <h2>{{ group.title }}</h2>
          {% if group.description %}
            <p class="group-description">{{ group.description }}</p>
          {% endif %}
        </div>

        <div class="member-grid">
          {% for member in group.members %}
            <article class="member-card">
              {% if member.image %}
                <div class="member-photo">
                  {% assign member_image_path = member.image | prepend: "assets/img/" %}
                  {% include figure.liquid loading="lazy" path=member_image_path alt=member.name %}
                </div>
              {% else %}
                {% assign name_parts = member.name | split: " " %}
                {% capture initials %}{% for part in name_parts limit: 2 %}{{ part | slice: 0, 1 }}{% endfor %}{% endcapture %}
                <div class="member-placeholder" aria-hidden="true">{{ initials }}</div>
              {% endif %}
              <div>
                <div class="member-name">{{ member.name }}</div>
                <div class="member-role">{{ member.role }}</div>
                {% if member.unit %}
                  <div class="member-unit">{{ member.unit }}</div>
                {% endif %}
                {% if member.focus %}
                  <p class="member-focus">{{ member.focus }}</p>
                {% endif %}
                {% if member.project %}
                  <p class="member-project"><strong>Project:</strong> {{ member.project }}</p>
                {% endif %}
                {% if member.email or member.links %}
                  <div class="member-links">
                    <span class="member-links-label">Contact:</span>
                    {% if member.email %}
                      <a href="mailto:{{ member.email }}">Email</a>
                    {% endif %}
                    {% for link in member.links %}
                      {% assign link_label = link.label | downcase %}
                      {% if link_label == "linkedin" or link_label == "website" or link_label contains "portfolio" %}
                        <a href="{{ link.url }}">
                          {% if link_label contains "portfolio" %}Website{% else %}{{ link.label }}{% endif %}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endfor %}

    {% for group in page.alumni_groups %}
      <section class="member-group scroll-reveal">
        <div class="group-head">
          <div class="section-kicker">Alumni</div>
          <h2>{{ group.title }}</h2>
        </div>
        <div class="alumni-grid">
          {% for person in group.people %}
            <article class="alumni-card">
              {% if person.image %}
                <div class="alumni-photo">
                  {% assign alumni_image_path = person.image | prepend: "assets/img/" %}
                  {% include figure.liquid loading="lazy" path=alumni_image_path alt=person.name %}
                </div>
              {% else %}
                {% assign name_parts = person.name | split: " " %}
                {% capture initials %}{% for part in name_parts limit: 2 %}{{ part | slice: 0, 1 }}{% endfor %}{% endcapture %}
                <div class="alumni-placeholder" aria-hidden="true">{{ initials }}</div>
              {% endif %}
              <div>
                <div class="alumni-name">{{ person.name }}</div>
                <div class="alumni-meta">
                  {% if person.degree %}{{ person.degree }}{% endif %}
                  {% if person.degree and person.affiliation %} | {% endif %}
                  {% if person.affiliation %}{{ person.affiliation }}{% endif %}
                </div>
                {% if person.project %}
                  <div class="alumni-project"><strong>DSSI project:</strong> {{ person.project }}</div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const reveals = document.querySelectorAll(".scroll-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    reveals.forEach((el) => observer.observe(el));
  });
</script>
