---
layout: page
---

<style>
  .people-shell {
    --dssi-line: rgba(23, 23, 23, 0.12);
    --dssi-muted: #5c6670;
    --dssi-soft: color-mix(in srgb, var(--global-card-bg-color) 90%, var(--global-theme-color) 10%);
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: none;
    overflow-x: hidden;
  }

  html[data-theme="dark"] .people-shell {
    --dssi-line: rgba(255, 255, 255, 0.14);
    --dssi-muted: #c5ccd3;
  }

  .people-inner {
    width: min(1120px, calc(100vw - 3rem));
    margin: 0 auto;
  }

  .section-kicker {
    margin-bottom: 0.7rem;
    color: var(--global-theme-color);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .principal-card {
    display: grid;
    grid-template-columns: minmax(250px, 0.42fr) minmax(0, 0.58fr);
    gap: 2.4rem;
    align-items: stretch;
    margin-bottom: 4rem;
    overflow: hidden;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
  }

  .principal-image {
    min-height: 410px;
    overflow: hidden;
    background: var(--dssi-soft);
  }

  .principal-image figure,
  .principal-image picture,
  .principal-image img {
    width: 100%;
    height: 100%;
    min-height: 410px;
    margin: 0;
  }

  .principal-image img {
    object-fit: cover;
  }

  .principal-body {
    padding: 2.1rem 2.1rem 2.1rem 0;
  }

  .principal-name {
    margin: 0 0 0.4rem;
    color: var(--global-text-color);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .principal-role,
  .member-role {
    color: var(--dssi-muted);
    line-height: 1.5;
  }

  .principal-meta {
    display: grid;
    gap: 0.25rem;
    margin: 1rem 0 1.4rem;
    font-size: 0.94rem;
  }

  .principal-details p,
  .member-bio p,
  .member-bio li {
    line-height: 1.62;
  }

  .member-group {
    padding: 3.5rem 0;
    border-top: 1px solid var(--dssi-line);
  }

  .group-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.4rem;
    margin-bottom: 1.4rem;
  }

  .group-head h2 {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.14;
  }

  .group-description {
    max-width: 680px;
    margin: 0.45rem 0 0;
    color: var(--dssi-muted);
    line-height: 1.6;
  }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .member-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }

  .member-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--global-theme-color) 55%, var(--dssi-line));
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.12);
  }

  .member-photo {
    height: 255px;
    overflow: hidden;
    background: var(--dssi-soft);
  }

  .member-photo figure,
  .member-photo picture,
  .member-photo img {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .member-photo img {
    object-fit: cover;
  }

  .member-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 255px;
    color: var(--global-theme-color);
    font-size: 2.1rem;
    font-weight: 800;
    background:
      linear-gradient(135deg, transparent 0, transparent 48%, rgba(186, 12, 47, 0.14) 48%, rgba(186, 12, 47, 0.14) 52%, transparent 52%),
      var(--dssi-soft);
  }

  .member-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.15rem;
  }

  .member-name {
    margin-bottom: 0.2rem;
    color: var(--global-text-color);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .member-bio {
    margin-top: 0.8rem;
    color: var(--global-text-color);
    font-size: 0.92rem;
  }

  .member-bio p:last-child {
    margin-bottom: 0;
  }

  .member-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .alumni-block {
    padding: 1.25rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
  }

  .alumni-block h3 {
    margin: 0 0 0.9rem;
    color: var(--global-text-color);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .alumni-block ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .alumni-block li {
    margin-bottom: 0.72rem;
    line-height: 1.5;
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 980px) {
    .principal-card,
    .member-grid,
    .alumni-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .principal-body {
      padding: 1.6rem 1.6rem 1.6rem 0;
    }
  }

  @media (max-width: 680px) {
    .people-inner {
      width: min(100% - 2rem, 1120px);
    }

    .principal-card,
    .member-grid,
    .alumni-grid {
      grid-template-columns: 1fr;
    }

    .principal-body {
      padding: 1.4rem;
    }

    .principal-image,
    .principal-image figure,
    .principal-image picture,
    .principal-image img {
      min-height: 310px;
    }
  }
</style>

<div class="people-shell">
  <div class="people-inner">
    {% if page.principal %}
      <section class="principal-card scroll-reveal">
        {% if page.principal.image %}
          <div class="principal-image">
            {% assign principal_image_path = page.principal.image | prepend: "assets/img/" %}
            {% include figure.liquid loading="eager" path=principal_image_path alt=page.principal.name %}
          </div>
        {% endif %}
        <div class="principal-body">
          <div class="section-kicker">Principal Investigator</div>
          <h2 class="principal-name">{{ page.principal.name }}</h2>
          <div class="principal-role">{{ page.principal.role }}</div>
          <div class="principal-meta">
            {% if page.principal.email %}
              <div>Email: <a href="mailto:{{ page.principal.email }}">{{ page.principal.email }}</a></div>
            {% endif %}
            {% if page.principal.office %}
              <div>Office: {{ page.principal.office }}</div>
            {% endif %}
            {% if page.principal.address %}
              <div>{{ page.principal.address }}</div>
            {% endif %}
            {% if page.principal.scholar %}
              <div><a href="{{ page.principal.scholar }}">Google Scholar</a></div>
            {% endif %}
          </div>
          {% if page.principal.content %}
            {% capture principal_content %}{% include_relative {{ page.principal.content }} %}{% endcapture %}
            <div class="principal-details">{{ principal_content | markdownify }}</div>
          {% endif %}
        </div>
      </section>
    {% endif %}

    {% for group in page.member_groups %}
      <section class="member-group scroll-reveal">
        <div class="group-head">
          <div>
            <div class="section-kicker">Current Members</div>
            <h2>{{ group.title }}</h2>
            {% if group.description %}
              <p class="group-description">{{ group.description }}</p>
            {% endif %}
          </div>
        </div>

        <div class="member-grid">
          {% for member in group.members %}
            <article class="member-card">
              {% if member.image %}
                <div class="member-photo">
                  {% assign member_image_path = member.image | prepend: "assets/img/" %}
                  {% include figure.liquid loading="lazy" path=member_image_path alt=member.name %}
                </div>
              {% else %}
                {% assign name_parts = member.name | split: " " %}
                {% capture initials %}{% for part in name_parts limit: 2 %}{{ part | slice: 0, 1 }}{% endfor %}{% endcapture %}
                <div class="member-placeholder" aria-hidden="true">{{ initials }}</div>
              {% endif %}
              <div class="member-body">
                <div class="member-name">{{ member.name }}</div>
                <div class="member-role">{{ member.role }}</div>
                {% if member.content %}
                  {% capture member_bio %}{% include_relative {{ member.content }} %}{% endcapture %}
                  {% assign member_heading = "### " | append: member.name %}
                  {% assign bio_without_heading = member_bio | replace_first: member_heading, "" %}
                  <div class="member-bio">{{ bio_without_heading | markdownify }}</div>
                {% endif %}
                {% if member.email or member.links %}
                  <div class="member-links">
                    {% if member.email %}
                      <a href="mailto:{{ member.email }}">Email</a>
                    {% endif %}
                    {% for link in member.links %}
                      <a href="{{ link.url }}">{{ link.label }}</a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endfor %}

    {% if page.alumni_groups %}
      <section class="member-group scroll-reveal">
        <div class="group-head">
          <div>
            <div class="section-kicker">Former Members</div>
            <h2>Alumni</h2>
          </div>
        </div>

        <div class="alumni-grid">
          {% for group in page.alumni_groups %}
            <div class="alumni-block">
              <h3>{{ group.title }}</h3>
              <ul>
                {% for person in group.people %}
                  <li>{{ person }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const reveals = document.querySelectorAll(".scroll-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    reveals.forEach((el) => observer.observe(el));
  });
</script>
