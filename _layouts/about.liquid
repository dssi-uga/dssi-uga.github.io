---
layout: default
---
<style>
  .about-shell {
    --dssi-red: #ba0c2f;
    --dssi-ink: #171717;
    --dssi-muted: #5c6670;
    --dssi-line: rgba(23, 23, 23, 0.12);
    --dssi-panel: var(--global-card-bg-color);
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: none;
    overflow-x: hidden;
  }

  html[data-theme="dark"] .about-shell {
    --dssi-ink: #f4f6f8;
    --dssi-muted: #c5ccd3;
    --dssi-line: rgba(255, 255, 255, 0.14);
  }

  .hero-section {
    position: relative;
    min-height: 56vh;
    display: flex;
    align-items: center;
    background-image: linear-gradient(90deg, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.36)), url("{{ '/assets/img/gallery/lab-equipment-1.jpg' | relative_url }}");
    background-size: cover;
    background-position: center;
    color: #ffffff;
  }

  .hero-content {
    width: min(1120px, calc(100vw - 3rem));
    margin: 0 auto;
    padding: 5.5rem 0 4.5rem;
  }

  .hero-kicker {
    margin-bottom: 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #f0d7dd;
  }

  .hero-brand-logo {
    display: block;
    width: min(220px, 48vw);
    height: auto;
    margin-bottom: 1.25rem;
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.45));
  }

  .hero-title {
    max-width: 850px;
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.2rem);
    line-height: 0.98;
    font-weight: 800;
    letter-spacing: 0;
    text-shadow:
      0 2px 4px rgba(0, 0, 0, 0.5),
      0 4px 8px rgba(0, 0, 0, 0.5),
      0 8px 16px rgba(0, 0, 0, 0.6),
      0 12px 24px rgba(0, 0, 0, 0.7);
    color: #ffffff;
  }

  .home-section {
    padding: 3.2rem 1.5rem;
    border-bottom: 1px solid var(--dssi-line);
    background: var(--global-bg-color);
  }

  .home-section.alt {
    background: color-mix(in srgb, var(--global-card-bg-color) 88%, var(--global-theme-color) 12%);
  }

  .home-section.light-band {
    background: var(--global-bg-color);
  }

  .home-inner {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .section-label {
    margin-bottom: 0.75rem;
    color: var(--global-theme-color);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .home-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 1.8rem;
    align-items: stretch;
  }

  .home-copy .post {
    margin: 0;
    min-height: 100%;
  }

  .director-message {
    position: relative;
    min-height: 100%;
    padding: 1.4rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(186, 12, 47, 0.1), transparent 38%),
      var(--dssi-panel);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .director-message:hover,
  .director-message:focus-within {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--global-theme-color) 55%, var(--dssi-line));
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.1);
  }

  .director-message::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 0%, rgba(255, 255, 255, 0.18) 45%, transparent 65%);
    transform: translateX(-100%);
    animation: message-shine 6s ease-in-out infinite;
  }

  .director-message h2 {
    margin-top: 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.12;
    color: var(--dssi-ink);
  }

  .director-message p {
    color: var(--global-text-color);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .stats-grid {
    position: relative;
    height: 236px;
    overflow: hidden;
    padding: 0.25rem 0;
    -webkit-mask-image: linear-gradient(transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(transparent, #000 10%, #000 90%, transparent);
  }

  .stats-track {
    display: grid;
    gap: 0.85rem;
    animation: stats-loop 18s linear infinite;
  }

  .stats-grid:hover .stats-track {
    animation-play-state: paused;
  }

  .stat-tile {
    min-height: 104px;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--dssi-line);
    border-left: 4px solid var(--global-theme-color);
    border-radius: 8px;
    background: var(--dssi-panel);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
    animation: stat-pulse 3.5s ease-in-out infinite;
  }

  .stat-tile:nth-child(2n) {
    animation-delay: 0.4s;
  }

  .stat-tile:nth-child(3n) {
    animation-delay: 0.8s;
  }

  .stat-value {
    display: block;
    color: var(--dssi-ink);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .stat-label {
    display: block;
    margin-top: 0.3rem;
    color: var(--dssi-muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.6rem;
  }

  .section-head h2 {
    margin: 0;
    color: var(--dssi-ink);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.16;
  }

  .section-head a {
    white-space: nowrap;
    font-weight: 700;
  }

  .conference-slider {
    position: relative;
    overflow: hidden;
    padding: 0.75rem 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .conference-track {
    display: flex;
    width: max-content;
    gap: 1rem;
    animation: conference-slide 24s linear infinite;
  }

  .conference-slider:hover .conference-track {
    animation-play-state: paused;
  }

  .conference-card {
    flex: 0 0 300px;
    display: grid;
    gap: 0.85rem;
    justify-items: center;
    padding: 1rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--dssi-panel);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .conference-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--global-theme-color) 55%, var(--dssi-line));
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.1);
  }

  .conference-logo {
    display: grid;
    place-items: center;
    width: 100%;
    height: 118px;
    padding: 0.75rem;
    overflow: visible;
    background: #ffffff;
  }

  .conference-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .conference-logo-image.logo-nsf {
    transform: scale(1.45);
    transform-origin: center;
  }

  .conference-label {
    color: var(--global-text-color);
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 0.18rem;
  }

  .home-section .news,
  .home-section .publications {
    padding: 1.4rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--dssi-panel);
  }

  .home-section .table {
    margin-bottom: 0;
  }

  .recruit-slider {
    position: relative;
    margin-top: 2rem;
    overflow: hidden;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(186, 12, 47, 0.1), transparent 40%),
      var(--dssi-panel);
  }

  .recruit-track {
    display: flex;
    width: 300%;
    animation: recruit-slide 15s infinite;
  }

  .recruit-card {
    flex: 0 0 33.333%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 180px;
    padding: 1.4rem 1.6rem;
  }

  .recruit-card h3 {
    margin: 0 0 0.55rem;
    color: var(--dssi-ink);
    font-size: 1.22rem;
    font-weight: 800;
  }

  .recruit-card p {
    margin: 0;
    color: var(--dssi-muted);
    line-height: 1.6;
  }

  .recruit-link {
    display: inline-flex;
    align-self: flex-start;
    margin-top: 1rem;
    font-weight: 800;
  }

  @keyframes stats-loop {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-50% - 0.425rem));
    }
  }

  @keyframes conference-slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  @keyframes stat-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.015);
    }
  }

  @keyframes message-shine {
    0%,
    58% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 992px) {
    .home-copy {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      min-height: 52vh;
    }

    .hero-content {
      width: min(100% - 2rem, 1120px);
      padding: 4.5rem 0 3rem;
    }

    .home-section {
      padding: 2.6rem 1rem;
    }

    .home-copy {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      height: 220px;
    }

    .section-head {
      display: block;
    }

    .section-head a {
      display: inline-block;
      margin-top: 0.5rem;
    }

    .conference-card {
      flex-basis: min(78vw, 300px);
    }
  }
</style>

<div class="about-shell">
  <section class="hero-section">
    <div class="hero-content scroll-reveal">
      <div class="hero-kicker">University of Georgia | College of Engineering</div>
      <img class="hero-brand-logo" src="{{ site.logo | relative_url }}" alt="MERIT logo">
      <h1 class="sr-only">MERIT: Manufacturing Empowered by Robotics, Intelligence, and Trustworthy Systems</h1>
    </div>
  </section>

  <section class="home-section">
    <div class="home-inner home-copy scroll-reveal">
      <div class="post">
        <article class="director-message" tabindex="0">
          <div class="section-label">MERIT Lab</div>
          <h2>Message from the Director</h2>
          <div class="clearfix">{{ content }}</div>
        </article>
      </div>

      {% if page.highlights %}
        <aside class="stats-grid" aria-label="Lab highlights">
          <div class="stats-track">
            {% for copy in (1..2) %}
              {% for item in page.highlights %}
                <div class="stat-tile">
                  <span class="stat-value">{{ item.value }}</span>
                  <span class="stat-label">{{ item.label }}</span>
                </div>
              {% endfor %}
            {% endfor %}
          </div>
        </aside>
      {% endif %}
    </div>
  </section>

  {% if page.news %}
    <section class="home-section">
      <div class="home-inner scroll-reveal">
        <div class="section-head">
          <div>
            <div class="section-label">Momentum</div>
            <h2>Recent News</h2>
          </div>
          <a href="{{ '/news/' | relative_url }}">All news</a>
        </div>
        {% include news.liquid limit=true %}
      </div>
    </section>
  {% endif %}

  {% if page.recruiting %}
    <section class="home-section light-band">
      <div class="home-inner scroll-reveal">
        <div class="section-head">
          <div>
            <div class="section-label">Join the Lab</div>
            <h2>We Are Recruiting</h2>
          </div>
          <a href="{{ '/teaching/' | relative_url }}">Details</a>
        </div>
        <div class="recruit-slider" aria-label="Recruiting opportunities">
          <div class="recruit-track">
            {% for item in page.recruiting %}
              <div class="recruit-card">
                <h3>{{ item.title }}</h3>
                <p>{{ item.text }}</p>
                <a class="recruit-link" href="{{ '/teaching/' | relative_url }}">How to apply</a>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if page.conference_logos %}
    <section class="home-section">
      <div class="home-inner scroll-reveal">
        <div class="section-head">
          <div>
            <div class="section-label">Where We Share Our Work</div>
            <h2>Affiliated Communities</h2>
          </div>
        </div>
        <div class="conference-slider" aria-label="Affiliated communities">
          <div class="conference-track">
            {% for copy in (1..2) %}
              {% for conference in page.conference_logos %}
                <article class="conference-card">
                  <div class="conference-logo">
                    {% assign conference_image_path = conference.image | prepend: 'assets/img/conferences/' %}
                    <img
                      class="conference-logo-image logo-{{ conference.label | slugify }}"
                      src="{{ conference_image_path | relative_url }}"
                      alt="{{ conference.label }} logo"
                    >
                  </div>
                  <div class="conference-label">{{ conference.label }}</div>
                </article>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const reveals = document.querySelectorAll('.scroll-reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    reveals.forEach((el) => observer.observe(el));
  });
</script>
