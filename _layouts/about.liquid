---
layout: default
---

<style>
  .about-shell {
    --dssi-red: #ba0c2f;
    --dssi-ink: #171717;
    --dssi-muted: #5c6670;
    --dssi-line: rgba(23, 23, 23, 0.12);
    --dssi-panel: var(--global-card-bg-color);
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: none;
    overflow-x: hidden;
  }

  html[data-theme="dark"] .about-shell {
    --dssi-ink: #f4f6f8;
    --dssi-muted: #c5ccd3;
    --dssi-line: rgba(255, 255, 255, 0.14);
  }

  .hero-section {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    background-image: linear-gradient(90deg, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.36)), url("{{ '/assets/img/gallery/lab-equipment-1.jpg' | relative_url }}");
    background-size: cover;
    background-position: center;
    color: #ffffff;
  }

  .hero-content {
    width: min(1120px, calc(100vw - 3rem));
    margin: 0 auto;
    padding: 5.5rem 0 4.5rem;
  }

  .hero-kicker {
    margin-bottom: 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #f0d7dd;
  }

  .hero-title {
    max-width: 850px;
    margin: 0 0 1.1rem;
    font-size: clamp(2.5rem, 8vw, 5.2rem);
    line-height: 0.98;
    font-weight: 800;
    letter-spacing: 0;
    text-shadow:
      0 2px 4px rgba(0, 0, 0, 0.5),
      0 4px 8px rgba(0, 0, 0, 0.5),
      0 8px 16px rgba(0, 0, 0, 0.6),
      0 12px 24px rgba(0, 0, 0, 0.7);
    color: #ffffff;
  }

  .hero-tagline {
    max-width: 850px;
    margin: 0 0 2rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
  }

  .home-section {
    padding: 4.5rem 1.5rem;
    border-bottom: 1px solid var(--dssi-line);
    background: var(--global-bg-color);
  }

  .home-section.alt {
    background: color-mix(in srgb, var(--global-card-bg-color) 88%, var(--global-theme-color) 12%);
  }

  .home-inner {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .section-label {
    margin-bottom: 0.75rem;
    color: var(--global-theme-color);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .home-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(240px, 0.75fr);
    gap: 2.5rem;
    align-items: start;
  }

  .home-copy .post {
    margin: 0;
  }

  .home-copy article h2 {
    margin-top: 0;
    font-size: clamp(1.75rem, 4vw, 2.45rem);
    line-height: 1.12;
    color: var(--dssi-ink);
  }

  .home-copy article p {
    color: var(--global-text-color);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .stats-grid {
    display: grid;
    gap: 0.85rem;
  }

  .stat-tile {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--dssi-line);
    border-left: 4px solid var(--global-theme-color);
    border-radius: 8px;
    background: var(--dssi-panel);
  }

  .stat-value {
    display: block;
    color: var(--dssi-ink);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .stat-label {
    display: block;
    margin-top: 0.3rem;
    color: var(--dssi-muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.6rem;
  }

  .section-head h2 {
    margin: 0;
    color: var(--dssi-ink);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.16;
  }

  .section-head a {
    white-space: nowrap;
    font-weight: 700;
  }

  .home-section .news,
  .home-section .publications {
    padding: 1.4rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--dssi-panel);
  }

  .home-section .table {
    margin-bottom: 0;
  }

  .recruit-slider {
    position: relative;
    margin-top: 2rem;
    overflow: hidden;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(186, 12, 47, 0.1), transparent 40%),
      var(--dssi-panel);
  }

  .recruit-track {
    display: flex;
    width: 300%;
    animation: recruit-slide 15s infinite;
  }

  .recruit-card {
    flex: 0 0 33.333%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 180px;
    padding: 1.4rem 1.6rem;
  }

  .recruit-card h3 {
    margin: 0 0 0.55rem;
    color: var(--dssi-ink);
    font-size: 1.22rem;
    font-weight: 800;
  }

  .recruit-card p {
    margin: 0;
    color: var(--dssi-muted);
    line-height: 1.6;
  }

  .recruit-link {
    display: inline-flex;
    align-self: flex-start;
    margin-top: 1rem;
    font-weight: 800;
  }

  @keyframes recruit-slide {
    0%,
    28% {
      transform: translateX(0);
    }
    33%,
    61% {
      transform: translateX(-33.333%);
    }
    66%,
    94% {
      transform: translateX(-66.666%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 992px) {
    .home-copy {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      min-height: 68vh;
    }

    .hero-content {
      width: min(100% - 2rem, 1120px);
      padding: 4.5rem 0 3rem;
    }

    .home-section {
      padding: 3rem 1rem;
    }

    .home-copy {
      grid-template-columns: 1fr;
    }

    .section-head {
      display: block;
    }

    .section-head a {
      display: inline-block;
      margin-top: 0.5rem;
    }
  }
</style>

<div class="about-shell">
  <section class="hero-section">
    <div class="hero-content scroll-reveal">
      <div class="hero-kicker">University of Georgia | College of Engineering</div>
      <h1 class="hero-title">DSSI Lab</h1>
      <p class="hero-tagline">Data Science and System Informatics for Secure, Ethical and Safe Smart Manufacturing.</p>
    </div>
  </section>

  <section class="home-section">
    <div class="home-inner home-copy scroll-reveal">
      <div class="post">
        <article>
          <div class="section-label">Data Science and System Informatics Lab</div>
          <div class="clearfix">{{ content }}</div>
        </article>
      </div>

      {% if page.highlights %}
        <aside class="stats-grid" aria-label="Lab highlights">
          {% for item in page.highlights %}
            <div class="stat-tile">
              <span class="stat-value">{{ item.value }}</span>
              <span class="stat-label">{{ item.label }}</span>
            </div>
          {% endfor %}
        </aside>
      {% endif %}
    </div>
  </section>

  {% if page.recruiting %}
    <section class="home-section alt">
      <div class="home-inner scroll-reveal">
        <div class="section-head">
          <div>
            <div class="section-label">Join the Lab</div>
            <h2>We Are Recruiting</h2>
          </div>
          <a href="{{ '/teaching/' | relative_url }}">Details</a>
        </div>
        <div class="recruit-slider" aria-label="Recruiting opportunities">
          <div class="recruit-track">
            {% for item in page.recruiting %}
              <div class="recruit-card">
                <h3>{{ item.title }}</h3>
                <p>{{ item.text }}</p>
                <a class="recruit-link" href="{{ '/teaching/' | relative_url }}">How to apply</a>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if page.news %}
    <section class="home-section alt">
      <div class="home-inner scroll-reveal">
        <div class="section-head">
          <div>
            <div class="section-label">Momentum</div>
            <h2>Recent News</h2>
          </div>
          <a href="{{ '/news/' | relative_url }}">All news</a>
        </div>
        {% include news.liquid limit=true %}
      </div>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section">
      <div class="home-inner scroll-reveal">
        <div class="section-head">
          <div>
            <div class="section-label">Selected Work</div>
            <h2>Research Publications</h2>
          </div>
          <a href="{{ '/publications/' | relative_url }}">Full list</a>
        </div>
        {% include selected_papers.liquid %}
      </div>
    </section>
  {% endif %}

</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const reveals = document.querySelectorAll(".scroll-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    reveals.forEach((el) => observer.observe(el));
  });
</script>
