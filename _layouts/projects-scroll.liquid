---
layout: page
---
<style>
  .research-shell {
    --dssi-line: rgba(23, 23, 23, 0.12);
    --dssi-muted: #5c6670;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: none;
    overflow-x: hidden;
  }

  html[data-theme='dark'] .research-shell {
    --dssi-line: rgba(255, 255, 255, 0.14);
    --dssi-muted: #c5ccd3;
  }

  .research-inner {
    width: min(1120px, calc(100vw - 3rem));
    margin: 0 auto;
  }

  .research-intro {
    padding: 1rem 0 3.5rem;
  }

  .research-intro > p:first-child {
    max-width: 880px;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .research-intro h2 {
    margin-top: 2.3rem;
    color: var(--global-text-color);
  }

  .research-intro h3 {
    margin-top: 1.6rem;
    color: var(--global-theme-color);
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .funding-band {
    padding: 1rem 0 3.5rem;
  }

  .funding-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.2rem;
  }

  .funding-head h2 {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 800;
  }

  .section-label {
    margin-bottom: 0.75rem;
    color: var(--global-theme-color);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .funding-marquee {
    position: relative;
    overflow: hidden;
    margin-top: 1rem;
    height: 396px;
    padding: 0.35rem 0;
    -webkit-mask-image: linear-gradient(transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(transparent, #000 8%, #000 92%, transparent);
  }

  .funding-track {
    display: grid;
    gap: 0.9rem;
    animation: funding-slide 16s steps(11, end) infinite;
  }

  .funding-marquee:hover .funding-track {
    animation-play-state: paused;
  }

  .funding-card {
    position: relative;
    overflow: hidden;
    min-height: 180px;
    padding: 1.1rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(186, 12, 47, 0.12), transparent 44%), var(--global-card-bg-color);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .funding-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent, rgba(255, 255, 255, 0.22), transparent);
    transform: translateX(-100%);
    animation: funding-shine 5s ease-in-out infinite;
  }

  .funding-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--global-theme-color) 50%, var(--dssi-line));
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.12);
  }

  .funding-award {
    position: relative;
    z-index: 1;
    color: var(--global-theme-color);
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1.05;
  }

  .funding-name {
    position: relative;
    z-index: 1;
    margin: 0.75rem 0;
    color: var(--global-text-color);
    font-weight: 800;
    line-height: 1.35;
  }

  .funding-meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--dssi-muted);
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .funding-meta span {
    padding: 0.18rem 0.45rem;
    border: 1px solid var(--dssi-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--global-card-bg-color) 92%, var(--global-theme-color) 8%);
  }

  @keyframes funding-slide {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-50% - 0.45rem));
    }
  }

  @keyframes funding-shine {
    0%,
    55% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .research-thrusts {
    border-top: 1px solid var(--dssi-line);
  }

  .project-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 1fr);
    gap: 2rem;
    align-items: stretch;
    min-height: 460px;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--dssi-line);
  }

  .project-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 390px;
  }

  .project-section.reverse .project-content {
    order: 2;
  }

  .project-section.reverse .project-image {
    order: 1;
  }

  .project-title {
    margin: 0 0 1rem;
    color: var(--global-text-color);
    font-size: clamp(1.7rem, 4vw, 2.45rem);
    font-weight: 800;
    line-height: 1.12;
  }

  .project-description {
    max-width: 680px;
    margin-bottom: 1.2rem;
    color: var(--dssi-muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .project-details h2 {
    margin-top: 1.5rem;
    color: var(--global-theme-color);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .project-details p,
  .project-details li {
    color: var(--global-text-color);
    line-height: 1.65;
  }

  .project-details ul {
    margin-left: 1.2rem;
    padding-left: 0.4rem;
  }

  .project-image {
    overflow: hidden;
    height: 390px;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.1);
  }

  .project-image figure,
  .project-image picture,
  .project-image img {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .project-image img {
    object-fit: cover;
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .research-inner {
      width: min(100% - 2rem, 1120px);
    }

    .funding-marquee {
      height: 382px;
    }

    .funding-head {
      display: block;
    }

    .project-section,
    .project-section.reverse {
      grid-template-columns: 1fr;
      gap: 1.6rem;
      padding: 3rem 0;
    }

    .project-section.reverse .project-content,
    .project-section.reverse .project-image {
      order: initial;
    }

    .project-image,
    .project-image figure,
    .project-image picture,
    .project-image img {
      height: 260px;
      min-height: 0;
    }
  }
</style>

<div class="research-shell">
  <div class="research-inner">
    <section class="research-intro scroll-reveal">
      {{ content }}
    </section>

    {% if page.funded_projects %}
      <section class="funding-band scroll-reveal" aria-label="Funded projects">
        <div class="funding-head">
          <div>
            <h2>Funded Projects</h2>
            <p class="project-description">Major active and selected completed awards supporting DSSI research.</p>
          </div>
        </div>

        <div class="section-label">Funding Portfolio</div>
        <div class="funding-marquee">
          <div class="funding-track">
            {% for copy in (1..2) %}
              {% for project in page.funded_projects.current %}
                <article class="funding-card">
                  <div class="funding-award">{{ project.award }}</div>
                  <div class="funding-name">{{ project.name }}</div>
                  <div class="funding-meta">
                    <span>{{ project.agency }}</span>
                    <span>{{ project.role }}</span>
                    <span>{{ project.period }}</span>
                  </div>
                </article>
              {% endfor %}
              {% for project in page.funded_projects.completed %}
                <article class="funding-card">
                  <div class="funding-award">{{ project.award }}</div>
                  <div class="funding-name">{{ project.name }}</div>
                  <div class="funding-meta">
                    <span>{{ project.agency }}</span>
                    <span>{{ project.role }}</span>
                    <span>{{ project.period }}</span>
                  </div>
                </article>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    <section class="research-thrusts" aria-label="Research thrusts">
      {% assign sorted_projects = site.projects | sort: 'importance' %}
      {% for project in sorted_projects %}
        {% assign remainder = forloop.index0 | modulo: 2 %}
        <article class="project-section scroll-reveal {% if remainder == 1 %}reverse{% endif %}">
          <div class="project-content">
            <h2 class="project-title">{{ project.title }}</h2>
            {% if project.description %}
              <p class="project-description">{{ project.description }}</p>
            {% endif %}
            <div class="project-details">
              {{ project.content }}
            </div>
          </div>
          <div class="project-image">
            {% if project.img %}
              {% include figure.liquid loading="lazy" path=project.img alt=project.title %}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </section>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const reveals = document.querySelectorAll('.scroll-reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    reveals.forEach((el) => observer.observe(el));
  });
</script>
