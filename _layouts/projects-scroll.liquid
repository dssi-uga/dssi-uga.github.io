---
layout: page
---
<!-- prettier-ignore -->
<style>
  .post-header {
    display: none;
  }
  .research-shell {
    --dssi-line: rgba(23, 23, 23, 0.12);
    --dssi-muted: #5c6670;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: none;
    overflow-x: hidden;
  }

  html[data-theme="dark"] .research-shell {
    --dssi-line: rgba(255, 255, 255, 0.14);
    --dssi-muted: #c5ccd3;
  }

  .research-inner {
    width: min(1120px, calc(100vw - 3rem));
    margin: 0 auto;
  }

  .research-intro {
    padding: 0;
  }

  .research-motivation {
    position: relative;
    left: 50%;
    right: 50%;
    width: 100vw;
    margin: 0 -50vw 0;
    padding: 6.5rem 0 4.5rem;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(234, 241, 239, 0.95) 0%, rgba(246, 248, 247, 0.95) 52%, rgba(229, 237, 234, 0.9) 100%);
  }

  .research-motivation::before {
    content: "";
    position: absolute;
    top: -6rem;
    right: -8vw;
    left: -8vw;
    height: 10rem;
    background: var(--global-bg-color);
    transform: rotate(2.4deg);
    transform-origin: left top;
  }

  .research-motivation::after {
    content: "";
    position: absolute;
    right: -10vw;
    bottom: -7rem;
    width: 68vw;
    height: 16rem;
    background: rgba(255, 255, 255, 0.72);
    transform: rotate(-19deg);
    transform-origin: right bottom;
  }

  .research-motivation-inner {
    position: relative;
    z-index: 1;
    width: min(1120px, calc(100vw - 3rem));
    margin: 0 auto;
  }

  .research-motivation-title {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 900;
    line-height: 1.05;
    text-align: center;
    text-transform: uppercase;
  }

  .research-motivation-rule {
    display: block;
    width: 4rem;
    height: 2px;
    margin: 1.35rem auto 1.8rem;
    background: var(--global-text-color);
  }

  .research-motivation-copy {
    color: var(--global-text-color);
    font-size: clamp(1.02rem, 1.6vw, 1.22rem);
    line-height: 1.75;
  }

  .research-motivation-copy p {
    margin-bottom: 1.35rem;
  }

  .research-motivation-copy p:last-child {
    margin-bottom: 0;
  }

  .funding-band {
    padding: 3.5rem 0;
  }

  .funding-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.2rem;
  }

  .funding-head h2 {
    margin: 0;
    color: var(--global-text-color);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 800;
  }

  .section-label {
    margin-bottom: 0.75rem;
    color: var(--global-theme-color);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .funding-marquee {
    position: relative;
    overflow: hidden;
    margin-top: 1rem;
    padding: 0.35rem 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .funding-track {
    display: flex;
    width: max-content;
    transform: translate3d(-50%, 0, 0);
    animation: funding-slide 32s linear infinite;
    will-change: transform;
  }

  .funding-group {
    display: flex;
    flex: 0 0 auto;
    gap: 0.8rem;
    padding-right: 0.8rem;
  }

  .funding-card {
    position: relative;
    flex: 0 0 260px;
    overflow: hidden;
    min-height: 132px;
    padding: 0.85rem;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(186, 12, 47, 0.12), transparent 44%), var(--global-card-bg-color);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .funding-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent, rgba(255, 255, 255, 0.22), transparent);
    transform: translateX(-100%);
    animation: funding-shine 5s ease-in-out infinite;
  }

  .funding-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--global-theme-color) 50%, var(--dssi-line));
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.12);
  }

  .funding-award {
    position: relative;
    z-index: 1;
    color: var(--global-theme-color);
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1.05;
  }

  .funding-name {
    position: relative;
    z-index: 1;
    margin: 0.55rem 0;
    color: var(--global-text-color);
    font-weight: 800;
    line-height: 1.28;
  }

  .funding-meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--dssi-muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .funding-meta span {
    padding: 0.18rem 0.45rem;
    border: 1px solid var(--dssi-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--global-card-bg-color) 92%, var(--global-theme-color) 8%);
  }

  @keyframes funding-slide {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes funding-shine {
    0%,
    55% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .research-thrusts {
    border-top: 1px solid var(--dssi-line);
  }

  .project-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--dssi-line);
  }

  .project-content {
    min-height: 0;
  }

  .project-title a {
    color: inherit;
    text-decoration: none;
  }

  .project-title a:hover {
    color: var(--global-theme-color);
    text-decoration: none;
  }

  .project-body {
    display: grid;
    grid-template-columns: minmax(420px, 0.6fr) minmax(0, 0.4fr);
    gap: 2rem;
    align-items: start;
  }

  .project-title {
    margin: 0 0 1rem;
    color: var(--global-text-color);
    font-size: clamp(1.7rem, 4vw, 2.45rem);
    font-weight: 800;
    line-height: 1.12;
  }

  .project-description {
    max-width: 680px;
    margin-bottom: 1.2rem;
    color: var(--dssi-muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .project-details h2 {
    margin-top: 0;
    color: var(--global-theme-color);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .project-details p,
  .project-details li {
    color: var(--global-text-color);
    line-height: 1.65;
  }

  .project-details ul {
    margin-left: 1.2rem;
    padding-left: 0.4rem;
  }

  .project-image {
    overflow: visible;
    height: auto;
    min-height: 0;
    margin: 0;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: transparent;
    box-shadow: none;
  }

  .project-image-link {
    display: block;
    color: inherit;
  }

  .project-image img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .research-inner {
      width: min(100% - 2rem, 1120px);
    }

    .funding-head {
      display: block;
    }

    .project-section,
    .project-section.reverse {
      padding: 3rem 0;
    }

    .project-body {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .project-image,
    .project-section.reverse .project-image,
    .project-section.reverse .project-details {
      order: initial;
      min-height: 0;
    }
  }
</style>

<!-- prettier-ignore -->
<div class="research-shell">
  <div class="research-inner">
    <section class="research-intro scroll-reveal" aria-label="Research overview">
      <div class="research-motivation">
        <div class="research-motivation-inner">
          <h2 class="research-motivation-title">Research Motivation</h2>
          <span class="research-motivation-rule" aria-hidden="true"></span>
          <div class="research-motivation-copy">
            {{ content }}
          </div>
        </div>
      </div>
    </section>

    {% if page.funded_projects %}
      <section class="funding-band scroll-reveal" aria-label="Funded projects">
        <div class="funding-head">
          <div>
            <h2>Funded Projects</h2>
            <p class="project-description">Major active and selected completed awards supporting MERIT research.</p>
          </div>
        </div>

        <div class="section-label">Funding Portfolio</div>
        <div class="funding-marquee">
          <div class="funding-track">
            {% for copy in (1..2) %}
              <div class="funding-group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
                {% for project in page.funded_projects.current %}
                  <article class="funding-card">
                    <div class="funding-award">{{ project.award }}</div>
                    <div class="funding-name">{{ project.name }}</div>
                    <div class="funding-meta">
                      <span>{{ project.agency }}</span>
                      <span>{{ project.role }}</span>
                      <span>{{ project.period }}</span>
                    </div>
                  </article>
                {% endfor %}
                {% for project in page.funded_projects.completed %}
                  <article class="funding-card">
                    <div class="funding-award">{{ project.award }}</div>
                    <div class="funding-name">{{ project.name }}</div>
                    <div class="funding-meta">
                      <span>{{ project.agency }}</span>
                      <span>{{ project.role }}</span>
                      <span>{{ project.period }}</span>
                    </div>
                  </article>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    <section class="research-thrusts" aria-label="Research thrusts">
      {% assign sorted_projects = site.projects | sort: 'importance' %}
      {% for project in sorted_projects %}
        {% assign remainder = forloop.index0 | modulo: 2 %}
        <article class="project-section scroll-reveal {% if remainder == 1 %}reverse{% endif %}">
          <div class="project-content">
            <h2 class="project-title">
              {% if project.link %}
                {% if project.link contains 'http' %}
                  {% assign project_href = project.link %}
                {% else %}
                  {% assign project_href = project.link | relative_url %}
                {% endif %}
                <a href="{{ project_href }}" {% if project.link contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ project.title }}</a>
              {% else %}
                {{ project.title }}
              {% endif %}
            </h2>
            {% if project.description %}
              <p class="project-description">{{ project.description }}</p>
            {% endif %}
            <div class="project-body">
              <div class="project-image">
                {% if project.img %}
                  {% assign project_image_src = project.img | relative_url %}
                  {% if project.link %}
                    {% if project.link contains 'http' %}
                      {% assign project_href = project.link %}
                    {% else %}
                      {% assign project_href = project.link | relative_url %}
                    {% endif %}
                    <a class="project-image-link" href="{{ project_href }}" {% if project.link contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %} aria-label="Open {{ project.title }}">
                      <img src="{{ project_image_src }}" alt="{{ project.title }}">
                    </a>
                  {% else %}
                    <img src="{{ project_image_src }}" alt="{{ project.title }}">
                  {% endif %}
                {% endif %}
              </div>
              <div class="project-details">
                {{ project.content }}
              </div>
            </div>
          </div>
        </article>
      {% endfor %}
    </section>
  </div>
</div>

<!-- prettier-ignore -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const reveals = document.querySelectorAll('.scroll-reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    reveals.forEach((el) => observer.observe(el));
  });
</script>
