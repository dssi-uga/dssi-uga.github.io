---
layout: page
---

<style>
  .research-shell {
    --dssi-line: rgba(23, 23, 23, 0.12);
    --dssi-muted: #5c6670;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    width: 100vw;
    max-width: none;
    overflow-x: hidden;
  }

  html[data-theme="dark"] .research-shell {
    --dssi-line: rgba(255, 255, 255, 0.14);
    --dssi-muted: #c5ccd3;
  }

  .research-inner {
    width: min(1120px, calc(100vw - 3rem));
    margin: 0 auto;
  }

  .research-intro {
    padding: 1rem 0 3.5rem;
  }

  .research-intro > p:first-child {
    max-width: 880px;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .research-intro h2 {
    margin-top: 2.3rem;
    color: var(--global-text-color);
  }

  .research-intro h3 {
    margin-top: 1.6rem;
    color: var(--global-theme-color);
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .research-intro table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
  }

  .research-intro th,
  .research-intro td {
    padding: 0.85rem 0.95rem;
    border-top: 1px solid var(--dssi-line);
    vertical-align: top;
  }

  .research-intro thead th {
    border-top: 0;
    color: var(--global-text-color);
    background: color-mix(in srgb, var(--global-card-bg-color) 86%, var(--global-theme-color) 14%);
  }

  .research-thrusts {
    border-top: 1px solid var(--dssi-line);
  }

  .project-section {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 3rem;
    align-items: center;
    min-height: 440px;
    padding: 4.5rem 0;
    border-bottom: 1px solid var(--dssi-line);
  }

  .project-section.reverse .project-content {
    order: 2;
  }

  .project-section.reverse .project-image {
    order: 1;
  }

  .project-title {
    margin: 0 0 1rem;
    color: var(--global-text-color);
    font-size: clamp(1.7rem, 4vw, 2.45rem);
    font-weight: 800;
    line-height: 1.12;
  }

  .project-description {
    max-width: 680px;
    margin-bottom: 1.2rem;
    color: var(--dssi-muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .project-details h2 {
    margin-top: 1.5rem;
    color: var(--global-theme-color);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .project-details p,
  .project-details li {
    color: var(--global-text-color);
    line-height: 1.65;
  }

  .project-details ul {
    margin-left: 1.2rem;
    padding-left: 0.4rem;
  }

  .project-image {
    overflow: hidden;
    min-height: 330px;
    border: 1px solid var(--dssi-line);
    border-radius: 8px;
    background: var(--global-card-bg-color);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.1);
  }

  .project-image figure,
  .project-image picture,
  .project-image img {
    width: 100%;
    height: 100%;
    min-height: 330px;
    margin: 0;
  }

  .project-image img {
    object-fit: cover;
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .research-inner {
      width: min(100% - 2rem, 1120px);
    }

    .project-section,
    .project-section.reverse {
      grid-template-columns: 1fr;
      gap: 1.6rem;
      padding: 3rem 0;
    }

    .project-section.reverse .project-content,
    .project-section.reverse .project-image {
      order: initial;
    }

    .project-image,
    .project-image figure,
    .project-image picture,
    .project-image img {
      min-height: 250px;
    }
  }
</style>

<div class="research-shell">
  <div class="research-inner">
    <section class="research-intro scroll-reveal">
      {{ content }}
    </section>

    <section class="research-thrusts" aria-label="Research thrusts">
      {% assign sorted_projects = site.projects | sort: "importance" %}
      {% for project in sorted_projects %}
        {% assign remainder = forloop.index0 | modulo: 2 %}
        <article class="project-section scroll-reveal {% if remainder == 1 %}reverse{% endif %}">
          <div class="project-content">
            <h2 class="project-title">{{ project.title }}</h2>
            {% if project.description %}
              <p class="project-description">{{ project.description }}</p>
            {% endif %}
            <div class="project-details">
              {{ project.content }}
            </div>
          </div>
          <div class="project-image">
            {% if project.img %}
              {% include figure.liquid loading="lazy" path=project.img alt=project.title %}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </section>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const reveals = document.querySelectorAll(".scroll-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    reveals.forEach((el) => observer.observe(el));
  });
</script>
